{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voice-notes",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },

  // Free Cloudflare AI. Powers both transcription and summaries.
  // No API key, no card, no third-party account.
  "ai": { "binding": "AI" },

  // Non-secret settings. Secrets (NOTION_TOKEN, NOTION_DATABASE_ID, APP_SECRET)
  // live in the dashboard under Settings → Variables and Secrets.
  "vars": {
    "TIMEZONE": "Europe/Berlin",
    "TRANSCRIBE_MAX_MB": "3"
  }
}
